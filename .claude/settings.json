{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm biome lint --fix ."
          },
          {
            "type": "command",
            "command": "pnpm biome format --write ."
          },
          {
            "type": "command",
            "command": "pnpm run typecheck"
          },
          {
            "type": "command",
            "command": "pnpm run test"
          }
        ]
      }
    ]
  }
}
