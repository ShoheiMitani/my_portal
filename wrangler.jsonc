{
  "name": "gomahari",
  "main": "src/index.tsx",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "gomahari.jp", "custom_domain": true }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trend-collector-db",
      "database_id": "8bd2c97a-2f0e-4893-8bb0-64f960ebf24a"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TrendCollector",
        "class_name": "TrendCollectorAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TrendCollectorAgent"]
    }
  ]
}
